[Unit]
Description=Google STT WebSocket Server
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/voicechat
EnvironmentFile=/opt/voicechat/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/voicechat/venv/bin/python3 /opt/voicechat/google_stt_server.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
