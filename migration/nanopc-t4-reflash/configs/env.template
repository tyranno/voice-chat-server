# voicechat-server .env 템플릿
# 실제 값은 NanoPi 백업 (nanopi-env.txt)에서 복사

PORT=8090
BRIDGE_PORT=9090
ACCESS_CODE=<원본에서 복사>
BRIDGE_TOKEN=<원본에서 복사>
TLS_ENABLED=false
DATA_DIR=/opt/voicechat/data
VOSK_URL=ws://127.0.0.1:2700
GOOGLE_STT_API_KEY=<원본에서 복사 — Google Cloud Speech-to-Text API key>
GOOGLE_TTS_API_KEY=<원본에서 복사>
FCM_SERVICE_ACCOUNT=/opt/voicechat/firebase-sa.json
LOCAL_OPENCLAW_URL=http://127.0.0.1:18790
LOCAL_OPENCLAW_NAME=NanoPi 렉스
LOCAL_OPENCLAW_TOKEN=<원본에서 복사>
BRIDGE_TLS_ENABLED=false
